# Beispielwerte für den Unterricht. Die echte .env steht in .gitignore.
RABBITMQ_USER=chat
RABBITMQ_PASSWORD=bitte-lokal-aendern

# Keycloak-Administrator. Wird nur beim allerersten Start angelegt.
# Die Admin-Oberfläche ist von aussen nicht erreichbar (offener Punkt 5),
# diese Zugangsdaten braucht man nur für "docker compose exec".
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=bitte-lokal-aendern
